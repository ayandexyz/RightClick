#!/usr/bin/env python3
"""Launcher for PDF Studio.

Runs from the source tree or from an installed copy: it puts its own folder on
the import path, and the package finds the shared daemon client beside it.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from pdf_studio.cli import main  # noqa: E402

sys.exit(main())
